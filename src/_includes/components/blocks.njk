{#- ==========================================================================
    Paginaspecifieke blokken (komen maar op één of twee pagina's voor).
    Importeer met {% import "components/blocks.njk" as b %}.
    ========================================================================== -#}
{% import "components/ui.njk" as ui %}
{% import "components/sections.njk" as s %}

{#- Paginering (Figma: Paginering). current = actieve pagina, total = aantal -#}
{% macro paginering(current=1, total=3) -%}
<nav class="pager" aria-label="Paginering" data-pager data-current="{{ current }}" data-total="{{ total }}">
  <button class="pager__arrow" type="button" aria-label="Vorige pagina" data-pager-prev{{ ' disabled' if current == 1 }}>{{ icon('arrow-left') }}</button>
  <ol class="pager__nums" role="list" data-pager-nums>
    {%- set nums = range(1, total + 1) if total <= 5 else [1, 2, 3, '…', total] -%}
    {% for n in nums %}{% if n == '…' %}<li class="pager__ellipsis" aria-hidden="true">…</li>{% else %}<li><a class="pager__num{{ ' is-active' if n == current }}" href="#" data-page="{{ n }}"{% if n == current %} aria-current="page"{% endif %}>{{ n }}</a></li>{% endif %}{% endfor %}
  </ol>
  <button class="pager__arrow" type="button" aria-label="Volgende pagina" data-pager-next{{ ' disabled' if current == total }}>{{ icon('arrow-right') }}</button>
</nav>
{%- endmacro %}

{#- Werkwijze: kop links (sticky), genummerde kaarten rechts die op elkaar stapelen bij scrollen -#}
{% macro werkwijze(d) -%}
<section class="ww">
  <div class="ww__inner">
    <div class="ww__side">
      <div class="ww__side-inner">
        <div class="stack" style="gap:var(--gap-heading-2)">
          <h2>{{ d.title }}</h2>
          <p class="body-lg c-secondary">{{ d.text }}</p>
        </div>
        {% if d.btn !== false %}{{ ui.btn('Gratis vochtadvies aanvragen', 'gratis-vochtadvies') }}{% endif %}
      </div>
    </div>
    <ol class="ww__cards" role="list">
      {% for c in d.cards %}
      <li class="ww__slot" style="--i: {{ loop.index0 }}">
        <div class="ww__card">
          <div class="ww__card-head"><span class="badge-num ww__badge">{{ loop.index }}</span><h3>{{ c.title }}</h3></div>
          <div class="ww__card-body">{% if c.subtitle %}<p class="bold">{{ c.subtitle }}</p>{% endif %}<p class="c-secondary">{{ c.text }}</p></div>
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
{%- endmacro %}

{#- Card / Resultaat: review met voor- en nafoto -#}
{% macro resultaat(r) -%}
<article class="result">
  <div class="result__body">
    {{ ui.stars(5) }}
    <p class="h4">{{ r.title }}</p>
    <p class="c-secondary">{{ r.text }}</p>
    <p class="bold">{{ r.name }}</p>
  </div>
  <div class="result__imgs">
    <figure class="result__img">{{ ui.media(r.before, 'Voor de behandeling', '1-1') }}<figcaption class="chip">Voor</figcaption></figure>
    <figure class="result__img">{{ ui.media(r.after, 'Na de behandeling', '1-1') }}<figcaption class="chip">Na</figcaption></figure>
  </div>
</article>
{%- endmacro %}

{#- Over ons: hoofdstukken met sticky foto links en tekst rechts -#}
{% macro verhaal(chapters) -%}
<section class="story">
  {% for c in chapters %}
  <div class="story__chapter" data-story-chapter>
    <div class="story__photo">{{ ui.media(c.image, '', '', '', 'story__media') }}</div>
    <div class="story__text">
      <div class="story__text-inner">
        <h2>{{ c.title }}</h2>
        <div class="prose body-lg c-secondary">{{ c.text | safe }}</div>
      </div>
    </div>
  </div>
  {% endfor %}
</section>
{%- endmacro %}


{#- Sectie / Project (Figma 09 Resultaten-secties, 3576:207).
    Desktop: witte kaart plakt vast onder de header; de fotokolom rechts scrolt langs alle stapfoto's,
    daarna scrolt de pagina verder. Mobiel en tablet: tekst, daarna stapfoto's swipen. Gedrag in main.js (data-project).
    p.id, p.kicker (blauwe eerste regel), p.title, p.blocks[{icon, title, text}], p.photos[{label, image}] -#}
{% macro project(p) -%}
<section class="project" id="{{ p.id }}" aria-labelledby="{{ p.id }}-titel" data-project>
  <div class="project__pin">
    <div class="project__card">
      <div class="project__text">
        <h2 id="{{ p.id }}-titel"><span class="c-blue">{{ p.kicker }}</span><br>{{ p.title }}</h2>   {#- Figma: Accentregel (blauw) + Titel -#}
        {{ s.uspList(p.blocks) }}
      </div>
      <div class="project__photos" data-project-photos>
        <div class="project__col" data-project-col>
          {% for f in p.photos %}
          <figure class="project__photo">{{ ui.media(f.image, f.label, '4-3') }}<figcaption class="chip">{{ f.label }}</figcaption></figure>
          {% endfor %}
        </div>
      </div>
      <div class="dots project__dots" data-project-dots></div>
    </div>
  </div>
</section>
{%- endmacro %}

{#- Sectie / Voor en na (Figma 16 okt, gekozen optie 1): Card / Resultaat Layout=Breed, één per rij,
    alleen onderschrift (H3) en voor- en nafoto; rating, reviewtekst en klant uit. Mobiel Gestapeld. -#}
{% macro voorNa(d) -%}
<section class="section">
  <div class="container stack" style="gap:var(--heading-gap)">
    <h2 class="t-center">{{ d.title }}</h2>
    <div class="results">
      {% for c in d.items %}
      <article class="result">
        <div class="result__body"><h3>{{ c.title }}</h3></div>
        <div class="result__imgs">
          <figure class="result__img">{{ ui.media(c.before, 'Voor', '1-1') }}<figcaption class="chip">Voor</figcaption></figure>
          <figure class="result__img">{{ ui.media(c.after, 'Na', '1-1') }}<figcaption class="chip">Na</figcaption></figure>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{%- endmacro %}
